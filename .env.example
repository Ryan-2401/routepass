# 이 파일을 복사해 .env.local 을 만들고 키를 채우세요. (.env.local 은 GitHub에 올라가지 않습니다)
# 키가 하나도 없어도 예시 여정(데모 모드)은 동작합니다.

# Google AI Studio 에서 발급 (일정 생성, 운행 판정, 식당 선택)
GEMINI_API_KEY=
# 모델 이름. 무료 등급에서 쓸 수 있는 Flash 계열을 권장합니다.
GEMINI_MODEL=gemini-flash-latest
# 기본 모델이 붐빌 때(503) 대신 쓸 모델들, 쉼표로 구분
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Tavily (운행 여부 웹 검색) – 월 1,000 크레딧 무료
TAVILY_API_KEY=

# SerpApi (Google Flights 실시간 가격) – 월 250회 무료
SERPAPI_KEY=

# Travelpayouts (Aviasales 캐시 가격) – 가입 후 Aviasales 프로그램 연결
TRAVELPAYOUTS_TOKEN=

# 공공데이터포털 (외교부 여행경보) – 일반 인증키(Decoding)
DATA_GO_KR_KEY=

# OpenStreetMap 요청에 붙이는 연락처 (이용 정책상 필요)
CONTACT_EMAIL=
